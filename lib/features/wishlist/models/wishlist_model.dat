class WishlistImage {
  final int id;
  final String uuid;
  final String image;
  final bool isPrimary;
  final int sortOrder;

  const WishlistImage({
    required this.id,
    required this.uuid,
    required this.image,
    required this.isPrimary,
    required this.sortOrder,
  });

  factory WishlistImage.fromJson(Map<String, dynamic> json) {
    return WishlistImage(
      id: json['id'] as int,
      uuid: json['uuid'] as String,
      image: json['image'] as String,
      isPrimary: json['is_primary'] as bool? ?? false,
      sortOrder: json['sort_order'] as int? ?? 0,
    );
  }
}

class WishlistProduct {
  final int id;
  final String uuid;
  final int sellerId;
  final int categoryId;
  final String name;
  final String slug;
  final String sku;
  final String description;
  final double price;
  final double? discountPrice;
  final int quantity;
  final String unit;
  final String? brand;
  final String? origin;
  final String status;
  final bool isFeatured;
  final bool isActive;
  final List<WishlistImage> images;

  const WishlistProduct({
    required this.id,
    required this.uuid,
    required this.sellerId,
    required this.categoryId,
    required this.name,
    required this.slug,
    required this.sku,
    required this.description,
    required this.price,
    required this.discountPrice,
    required this.quantity,
    required this.unit,
    required this.brand,
    required this.origin,
    required this.status,
    required this.isFeatured,
    required this.isActive,
    required this.images,
  });

  factory WishlistProduct.fromJson(Map<String, dynamic> json) {
    final rawImages = json['images'] as List<dynamic>? ?? [];

    return WishlistProduct(
      id: json['id'] as int,
      uuid: json['uuid'] as String,
      sellerId: json['seller_id'] as int,
      categoryId: json['category_id'] as int,
      name: json['name'] as String,
      slug: json['slug'] as String,
      sku: json['sku'] as String,
      description: json['description'] as String? ?? '',
      price: _toDouble(json['price']),
      discountPrice: json['discount_price'] == null
          ? null
          : _toDouble(json['discount_price']),
      quantity: json['quantity'] as int? ?? 0,
      unit: json['unit'] as String? ?? '',
      brand: json['brand'] as String?,
      origin: json['origin'] as String?,
      status: json['status'] as String? ?? 'active',
      isFeatured: json['is_featured'] as bool? ?? false,
      isActive: json['is_active'] as bool? ?? true,
      images: rawImages
          .whereType<Map<String, dynamic>>()
          .map(WishlistImage.fromJson)
          .toList(),
    );
  }

  bool get hasDiscount =>
      discountPrice != null && discountPrice! < price;

  double get currentPrice =>
      hasDiscount ? discountPrice! : price;

  bool get isAvailable =>
      isActive && quantity > 0 && status.toLowerCase() == 'active';

  String? get primaryImage {
    if (images.isEmpty) return null;

    final primary = images.where((image) => image.isPrimary);

    if (primary.isNotEmpty) {
      return primary.first.image;
    }

    final sorted = [...images]
      ..sort((a, b) => a.sortOrder.compareTo(b.sortOrder));

    return sorted.first.image;
  }

  static double _toDouble(dynamic value) {
    if (value is num) return value.toDouble();
    return double.tryParse(value?.toString() ?? '0') ?? 0;
  }
}

class WishlistItem {
  final int id;
  final String uuid;
  final int userId;
  final int productId;
  final WishlistProduct product;

  const WishlistItem({
    required this.id,
    required this.uuid,
    required this.userId,
    required this.productId,
    required this.product,
  });

  factory WishlistItem.fromJson(Map<String, dynamic> json) {
    return WishlistItem(
      id: json['id'] as int,
      uuid: json['uuid'] as String,
      userId: json['user_id'] as int,
      productId: json['product_id'] as int,
      product: WishlistProduct.fromJson(
        json['product'] as Map<String, dynamic>,
      ),
    );
  }
}

class WishlistMessage {
  final bool success;
  final String message;

  const WishlistMessage({
    required this.success,
    required this.message,
  });

  factory WishlistMessage.fromJson(Map<String, dynamic> json) {
    return WishlistMessage(
      success: json['success'] as bool? ?? false,
      message: json['message'] as String? ?? '',
    );
  }
}